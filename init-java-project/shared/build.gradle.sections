// Canonical shared build sections for the Java/Gradle projects. Each block is wrapped in begin and end
// markers naming it (the same markers in every project). check-shared-sections.sh compares the blocks.
// Edit a section here, then copy the change into each project in the same change set.

// shared:begin build
// The version catalog uses dynamic ranges, and those ranges accept prereleases: an unfiltered
// slf4j "2.+" resolves to 2.1.0-alpha1. Match known prerelease qualifiers rather than allowlisting
// stable ones. Stable releases carry odd suffixes — 0.0.20131108.vaadin1 (a spring-boot-starter-test
// transitive) and 2.3.1-b170201.1204 are both stable — and an allowlist rejects them, which breaks
// resolution with "Could not find" rather than picking a different version.
configurations.all {
    resolutionStrategy.componentSelection.all { selection ->
        if (selection.candidate.version ==~ /(?i).*[.\-](alpha|beta|rc|cr|snapshot|preview|dev|milestone|m\d+)[.\-]?\d*$/) {
            selection.reject('prerelease version')
        }
    }
}

java {
    toolchain {
        languageVersion = JavaLanguageVersion.of(libs.versions.java.get())
    }
    withSourcesJar()
    withJavadocJar()
}

tasks.withType(JavaCompile).configureEach {
    options.release = libs.versions.release.get().toInteger()
}

dependencies {
    constraints {
        libs.bundles.security.patches.get().each {
            add('implementation', it)
        }
    }
}

tasks.named('jacocoTestReport') {
    dependsOn tasks.named('test')
    reports {
        html.required = true
        xml.required = false
    }
}

spotless {
    java {
        targetExclude 'src/*/java/module-info.java'
        googleJavaFormat()
        removeUnusedImports()
        trimTrailingWhitespace()
        endWithNewline()
    }
}

// The NVD key is optional. Without one, the check uses the local NVD cache and warns.
def nvdKey = providers.environmentVariable('NVD_API_KEY')
    .orElse(providers.gradleProperty('nvd.apiKey')).orNull

dependencyCheck {
    failBuildOnCVSS = 7
    if (nvdKey) {
        nvd { apiKey = nvdKey }
    } else {
        autoUpdate = false
    }
}

tasks.named('dependencyCheckAnalyze') {
    doFirst {
        if (!nvdKey) {
            logger.warn('NVD_API_KEY is not set: using the local NVD cache without a live update.')
        }
    }
}

tasks.withType(Javadoc).configureEach {
    options {
        encoding = 'UTF-8'
        links "https://docs.oracle.com/en/java/javase/${libs.versions.java.get()}/docs/api/"
        addBooleanOption('html5', true)
        // Standard JDK documentation tags are not registered for non-JDK code by default
        tags(
                'apiNote:a:API Note:',
                'implSpec:a:Implementation Requirements:',
                'implNote:a:Implementation Note:'
        )
    }
}
// shared:end build

